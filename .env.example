# My Assistant - Environment Variables
# Copy this file to .env and fill in your values

# AI Provider API Keys (choose one or more)
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here
GOOGLE_API_KEY=your_google_api_key_here

# Optional: Weather API (for weather commands)
WEATHER_API_KEY=your_weather_api_key_here

# Optional: News API (for news commands)
NEWS_API_KEY=your_news_api_key_here

# Optional: Translation API
TRANSLATION_API_KEY=your_translation_api_key_here

# Application Settings (optional, can also be set in config.json)
ASSISTANT_LANGUAGE=en
ASSISTANT_THEME=dark
ASSISTANT_LOG_LEVEL=INFO
